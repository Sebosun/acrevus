PORT=1234

# Local development Postgres (Docker Compose).
POSTGRES_USER=acrevus
POSTGRES_PASSWORD=acrevus_dev
POSTGRES_DB=acrevus
POSTGRES_PORT=5432

# Host-side connection. URL-encode credentials if they contain URL-special characters.
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable

# Goose automatically loads .env when run from the repository root.
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=${DATABASE_URL}
GOOSE_MIGRATION_DIR=./db/migrations
